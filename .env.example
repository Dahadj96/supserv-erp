# ---- app
NODE_ENV=development
APP_URL=https://erp.<your-tailnet>.ts.net   # LAN fallback: http://<server-ip>:3000

# ---- database (Dokploy creates this service)
DATABASE_URL=postgres://supserv:CHANGEME@postgres:5432/supserv

# ---- auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://erp.<your-tailnet>.ts.net

# ---- Microsoft 365  (Entra ID app registration)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SHARED_MAILBOX=contact@supserv.dz

# Application Mail.Read reaches EVERY mailbox in the tenant until Exchange RBAC
# for Applications scopes it to one. Run scripts/scope-mailbox.ps1, see it
# report PASS, then remove the org-wide consent from Entra — the two grants are
# ADDED together, so leaving the Entra one on gives no scoping at all.
# Only then set this true. See docs/MAILBOX-ACCESS.md.
MS_MAILBOX_SCOPE_CONFIRMED=false
MS_SHAREPOINT_SITE_ID=
MS_SHAREPOINT_DRIVE_ID=

# ---- storage
STORAGE_DRIVER=local          # local | sharepoint | s3
STORAGE_LOCAL_PATH=/data/files

# ---- backup   the single most important section on an office server
BACKUP_LOCAL_PATH=/mnt/usb-backup          # external SSD, plugged in
BACKUP_SHAREPOINT_FOLDER=/Backups/ERP      # off-site, already paid for
BACKUP_ENCRYPTION_KEY=                     # openssl rand -base64 32
BACKUP_AT=02:30                            # nightly
# restore one into a scratch database on the first Saturday of each month.
# a backup you have never restored is not a backup.

# ---- ocr   free, on this VPS. No account. See docs/OCR.md
OCR_URL=http://ocr:3002
OCR_LANGS=fra+ara+eng
OCR_PSM=3                     # 3 = auto. NEVER 6 — it destroys tables
OCR_REVIEW_THRESHOLD=0.8
# escape hatch only. Leave empty — you are not paying for this.
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# ---- pdf renderer
RENDERER_URL=http://renderer:3001
