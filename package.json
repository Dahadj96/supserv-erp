{
  "name": "supserv-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "pnpm typecheck && pnpm lint && pnpm audit:actions && pnpm audit:forms && pnpm audit:schema && pnpm test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "audit:actions": "node scripts/audit-actions.mjs",
    "shots": "tsx --env-file=.env scripts/screenshots.ts",
    "phone": "tsx --env-file=.env scripts/phone-drawer.ts",
    "format": "biome check --write .",
    "test": "node scripts/test-db.mjs && vitest run --config vitest.config.mts",
    "test:db": "node scripts/test-db.mjs",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-routes.mjs",
    "smoke:in": "tsx --env-file=.env scripts/smoke-signed-in.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx --env-file=.env src/jobs/worker.ts",
    "catalogue": "tsx --env-file=.env scripts/seed-catalogue.ts",
    "audit:forms": "node scripts/audit-forms.mjs",
    "audit:schema": "node scripts/audit-schema.mjs",
    "walk": "tsx --env-file=.env scripts/click-the-marche.ts",
    "backfill:attachments": "tsx --env-file=.env scripts/backfill-attachments.ts",
    "audit:buttons": "node scripts/audit-buttons.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@hookform/resolvers": "5.9.1",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "@node-rs/argon2": "2.1.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "9.1.2",
    "better-auth": "1.7.1",
    "cmdk": "1.1.1",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "exceljs": "4.4.0",
    "geist": "^1.7.2",
    "lucide-react": "1.33.0",
    "next": "16.3.1",
    "next-intl": "4.13.7",
    "nuqs": "2.9.6",
    "papaparse": "5.6.0",
    "pdf-lib": "1.17.1",
    "pg-boss": "12.27.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.3",
    "sonner": "2.0.8",
    "unpdf": "1.8.1",
    "yauzl": "^3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.9.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@types/yauzl": "^3.4.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
